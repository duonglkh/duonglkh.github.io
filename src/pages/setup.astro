---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG, SOCIAL_LINKS } from '../config';
---

<Layout
  title={`My Desk Setup — ${SITE_CONFIG.title}`}
  description="A look at the gear and tools that make up my daily setup."
>
  <main class="placeholder">
    <a href="/" class="back">← Back to home</a>

    <header class="hero">
      <h1 class="title">My Desk Setup</h1>
      <p class="tagline">
        Hardware, peripherals, and the small things that make my day better.
      </p>
    </header>

    <section class="groups">
      {[
        { id: 'desk', label: 'Desk', items: ['Standing desk', 'Chair', 'Monitor arm'] },
        { id: 'hardware', label: 'Hardware', items: ['Main machine', 'Phone (Android)', 'Test devices'] },
        { id: 'peripherals', label: 'Peripherals', items: ['Keyboard', 'Mouse', 'Headphones', 'Monitor'] },
        { id: 'software', label: 'Software stack', items: ['Android Studio', 'Claude Code', 'Cursor', 'Raycast'] },
      ].map((g) => (
        <article class="group" id={g.id}>
          <h2>{g.label}</h2>
          <ul>
            {g.items.map((it) => (
              <li>
                <span class="dot"></span>
                <span class="name">{it}</span>
                <span class="hint">tbd</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <p class="footnote">
      Each line will get a model name, link, and 1 sentence on why I picked it.
      Follow updates on <a href={SOCIAL_LINKS.youtube}>YouTube</a> and
      <a href={SOCIAL_LINKS.tiktok}>TikTok</a>.
    </p>
  </main>
</Layout>

<style>
  .placeholder {
    max-width: 720px;
    margin: 0 auto;
    padding: 5rem 1.5rem 4rem;
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .back:hover {
    color: var(--accent);
  }

  .hero {
    margin-top: 2rem;
    margin-bottom: 3rem;
  }

  .title {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    background: var(--gradient-accent);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1rem;
  }

  .tagline {
    color: var(--fg-dim);
    font-size: 1.05rem;
    max-width: 36rem;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .group {
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.1rem 1.2rem;
  }

  .group h2 {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-dim);
    margin: 0 0 0.85rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.55rem;
  }

  .group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .group li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.88rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .name {
    color: var(--fg);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--fg-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footnote {
    margin-top: 2rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  @media (max-width: 520px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .title {
      font-size: 2rem;
    }
  }
</style>
