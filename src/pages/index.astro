---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import CcafExamCard from '../components/CcafExamCard.astro';
import AnthropicCourses from '../components/AnthropicCourses.astro';
import SectionNav from '../components/SectionNav.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';
import { SITE_CONFIG } from '../config';

const extensions = (await getCollection('extensions')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const courses = (await getCollection('courses')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const tokenTools = (await getCollection('tokenTools')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const shorts = (await getCollection('shorts')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
---

<Layout title={SITE_CONFIG.title}>
  <SectionNav />
  <main>
    <Hero />

    <div id="learn" class="section-group">
      <div class="group-head">
        <span class="group-num">①</span>
        <h2 class="group-title">Claude & AI Learning</h2>
        <span class="group-rule"></span>
      </div>

      <ClaudeRoadmap />

      <section id="cca-f" class="mb-section">
        <h2>CCA-F Exam Prep</h2>
        <CcafExamCard />
      </section>

      <section id="anthropic-courses">
        <h2>Anthropic Free Courses</h2>
        <AnthropicCourses />
      </section>

      {
        courses.length > 0 && (
          <section id="courses">
            <h2>Claude Knowledge Base</h2>
            <div class="grid">
              {courses.map((c) => (
                <CourseCard id={c.id} {...c.data} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div id="build" class="section-group">
      <div class="group-head">
        <span class="group-num">②</span>
        <h2 class="group-title">Open Source</h2>
        <span class="group-rule"></span>
      </div>

      {
        projects.length > 0 && (
          <section id="projects">
            <h2>Open Source Repos</h2>
            <div class="grid">
              {projects.map((p) => (
                <ProjectCard {...p.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        extensions.length > 0 && (
          <section id="extensions">
            <h2>AIDLC · SDLC Pipeline</h2>
            <div class="grid">
              {extensions.map((e) => (
                <ExtensionCard {...e.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        tokenTools.length > 0 && (
          <section id="token-optimization">
            <h2>Token Optimization</h2>
            <div class="grid">
              {tokenTools.map((t) => (
                <ProjectCard {...t.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        shorts.length > 0 && (
          <section id="ai-video-generators">
            <h2>AI Video Generators</h2>
            <div class="grid">
              {shorts.map((s) => (
                <ProjectCard {...s.data} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div id="shop" class="section-group">
      <div class="group-head">
        <span class="group-num">③</span>
        <h2 class="group-title">WFH Setup</h2>
        <span class="group-rule"></span>
      </div>

      <section id="wfh-setup-teaser">
        <p class="teaser">
          Desk · keyboard · monitor stack · daily software. <a href="/setup/">See the full setup &rarr;</a>
        </p>
      </section>
    </div>

    <div id="support" class="section-group">
      <div class="group-head">
        <span class="group-num">④</span>
        <h2 class="group-title">Support</h2>
        <span class="group-rule"></span>
      </div>

      <Support />
    </div>
  </main>
</Layout>

<style is:global>
  .section-group {
    margin-bottom: 4.5rem;
  }

  .section-group > section {
    margin-bottom: 2.75rem;
  }

  .section-group > section:last-child {
    margin-bottom: 0;
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .group-num {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent);
    line-height: 1;
  }

  .group-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-transform: none;
    background: var(--gradient-accent);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .group-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--accent-2) 30%,
      var(--accent-3) 70%,
      transparent
    );
    background-size: 200% 100%;
    animation: cosmic-ray 7s ease-in-out infinite;
    opacity: 0.55;
  }

  @keyframes cosmic-ray {
    0%, 100% { background-position: 0% 50%; opacity: 0.35; }
    50% { background-position: 100% 50%; opacity: 0.85; }
  }

  @media (prefers-reduced-motion: reduce) {
    .group-rule { animation: none; opacity: 0.5; }
  }

  .shop-card {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .shop-card:hover {
    color: inherit;
  }

  .teaser {
    color: var(--fg-dim);
    font-size: 0.95rem;
    padding: 1.25rem 1.4rem;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* SUPPORT group: the inner Support section already has its own h2.
     Keep it, but the group head ("Support") sits above. */
  #support > section { margin-bottom: 0; }

  /* ============================================================
     COSMIC LAYOUT — group heads as centered "[ I ] MISSION" labels
     ============================================================ */

  :root[data-layout='cosmic'] .section-group {
    margin-bottom: 5.5rem;
  }

  :root[data-layout='cosmic'] .group-head {
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
    margin-bottom: 2.5rem;
    padding-top: 1rem;
  }

  :root[data-layout='cosmic'] .group-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    color: var(--accent);
    opacity: 0.85;
    text-transform: uppercase;
  }

  /* Replace ① ② ③ ④ with [ I ] [ II ] [ III ] [ IV ] */
  :root[data-layout='cosmic'] .group-num { visibility: hidden; position: relative; }
  :root[data-layout='cosmic'] .group-num::after {
    visibility: visible;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  :root[data-layout='cosmic'] #learn .group-num::after { content: '[ MISSION  I ]'; }
  :root[data-layout='cosmic'] #build .group-num::after { content: '[ MISSION  II ]'; }
  :root[data-layout='cosmic'] #shop .group-num::after { content: '[ MISSION  III ]'; }
  :root[data-layout='cosmic'] #support .group-num::after { content: '[ MISSION  IV ]'; }

  :root[data-layout='cosmic'] .group-title {
    font-size: 1.65rem;
  }

  :root[data-layout='cosmic'] .group-rule {
    flex: none;
    height: 1px;
    width: 100%;
    max-width: 380px;
    margin: 0.35rem auto 0;
  }
</style>
