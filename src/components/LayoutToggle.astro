---
---

<button
  class="layout-toggle"
  type="button"
  aria-label="Toggle layout"
  title="Toggle layout (Cosmic / Classic)"
>
  <span class="icon icon-cosmic" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="3.2"></circle>
      <ellipse cx="12" cy="12" rx="9.5" ry="4" transform="rotate(-22 12 12)"></ellipse>
      <circle cx="20" cy="9.5" r="0.8" fill="currentColor"></circle>
    </svg>
  </span>
  <span class="icon icon-classic" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="5" width="16" height="3.4" rx="1"></rect>
      <rect x="4" y="11" width="16" height="3.4" rx="1"></rect>
      <rect x="4" y="17" width="16" height="2.2" rx="1"></rect>
    </svg>
  </span>
</button>

<script is:inline>
  (() => {
    const btn = document.querySelector('.layout-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-layout') || 'cosmic';
      const next = current === 'cosmic' ? 'classic' : 'cosmic';
      document.documentElement.setAttribute('data-layout', next);
      try {
        localStorage.setItem('layout', next);
      } catch (e) {}
    });
  })();
</script>

<style>
  .layout-toggle {
    position: fixed;
    top: 1.25rem;
    right: 4.4rem;
    z-index: 10;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, transform 150ms ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .layout-toggle:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
    transform: scale(1.05);
  }

  .layout-toggle:focus-visible {
    outline: 2px solid var(--accent-2);
    outline-offset: 2px;
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: opacity 150ms ease, transform 200ms ease;
  }

  /* Cosmic mode: show classic icon (you're in cosmic, click to go classic) */
  :root[data-layout='cosmic'] .icon-cosmic,
  :root:not([data-layout='classic']) .icon-cosmic {
    position: absolute;
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
    pointer-events: none;
  }
  :root[data-layout='cosmic'] .icon-classic,
  :root:not([data-layout='classic']) .icon-classic {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  :root[data-layout='classic'] .icon-classic {
    position: absolute;
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
    pointer-events: none;
  }
  :root[data-layout='classic'] .icon-cosmic {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (max-width: 640px) {
    .layout-toggle {
      top: 1rem;
      right: 3.6rem;
      width: 34px;
      height: 34px;
    }
  }
</style>
