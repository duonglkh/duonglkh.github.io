---
const COURSES = [
  {
    title: 'Claude with the API',
    duration: '~4h',
    level: 'Beginner',
    url: 'https://anthropic.skilljar.com/claude-with-the-anthropic-api',
  },
  {
    title: 'Prompt Engineering Interactive Tutorial',
    duration: '~3h',
    level: 'Beginner',
    url: 'https://github.com/anthropics/prompt-eng-interactive-tutorial',
  },
  {
    title: 'Real-world Prompting',
    duration: '~2h',
    level: 'Intermediate',
    url: 'https://anthropic.skilljar.com/real-world-prompting',
  },
  {
    title: 'Tool Use with Claude',
    duration: '~3h',
    level: 'Intermediate',
    url: 'https://anthropic.skilljar.com/tool-use-with-claude',
  },
  {
    title: 'Model Context Protocol (MCP)',
    duration: '~2h',
    level: 'Intermediate',
    url: 'https://anthropic.skilljar.com/model-context-protocol',
  },
  {
    title: 'Claude Code in Action',
    duration: '~2h',
    level: 'All',
    url: 'https://anthropic.skilljar.com/claude-code-in-action',
  },
];
---

<div class="course-grid">
  {COURSES.map((c) => (
    <a class="course-card" href={c.url} target="_blank" rel="noopener">
      <div class="row-top">
        <span class="level">{c.level}</span>
        <span class="duration">{c.duration}</span>
      </div>
      <h3>{c.title}</h3>
      <span class="cta">Open ↗</span>
    </a>
  ))}
</div>

<style>
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.85rem;
  }

  .course-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.95rem 1rem;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .course-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-2px);
    color: inherit;
  }

  .row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .level {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    padding: 0.1rem 0.45rem;
    background: var(--accent-soft);
    border-radius: 3px;
  }

  .duration {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
  }

  .course-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
    color: var(--fg);
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--accent-2);
    margin-top: auto;
  }
</style>
