---
const EXAM = {
  badge: 'FREE TRACK',
  code: 'SKILLJAR',
  title: 'Anthropic Skilljar Track',
  tagline: 'Lộ trình free khóa học chính thức của Anthropic — badge hoàn thành',
  meta: [
    { k: 'Courses', v: '6 modules' },
    { k: 'Time', v: '~15-20h' },
    { k: 'Cost', v: 'Free + badges' },
  ],
  cta: { label: 'Mở Skilljar', href: 'https://anthropic.skilljar.com' },
};
---

<a class="exam-card" href={EXAM.cta.href} target="_blank" rel="noopener">
  <div class="exam-head">
    <span class="badge">{EXAM.badge}</span>
    <span class="code">{EXAM.code}</span>
  </div>
  <h3 class="title">{EXAM.title}</h3>
  <p class="tagline">{EXAM.tagline}</p>
  <dl class="meta">
    {EXAM.meta.map((m) => (
      <div class="meta-row">
        <dt>{m.k}</dt>
        <dd>{m.v}</dd>
      </div>
    ))}
  </dl>
  <span class="cta">{EXAM.cta.label} &rarr;</span>
</a>

<style>
  .exam-card {
    display: block;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent-2);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    color: inherit;
    transition: border-color 200ms ease, transform 200ms ease;
    position: relative;
  }

  .exam-card:hover {
    border-color: var(--accent-2);
    border-left-color: var(--accent-3);
    transform: translateY(-1px);
  }

  .exam-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent-2);
    border: 1px solid var(--accent-2);
    padding: 2px 8px;
    border-radius: 12px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    letter-spacing: 0.16em;
  }

  .title {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 0.35rem;
    color: var(--fg);
  }

  .tagline {
    color: var(--fg-dim);
    font-size: 0.82rem;
    margin: 0 0 0.85rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0;
  }

  .meta-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.25rem 0.55rem;
    background: rgba(2, 3, 10, 0.45);
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .meta-row dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
    margin: 0;
  }

  .meta-row dd {
    color: var(--fg);
    font-size: 0.75rem;
    font-weight: 500;
    margin: 0;
  }

  .cta {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }
</style>
