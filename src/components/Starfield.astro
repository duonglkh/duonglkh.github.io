---
type Layer = { count: number; size: string };

const seedRand = (seed: number) => {
  let s = seed;
  return () => {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
};

const shadow = (count: number, seed: number) => {
  const rand = seedRand(seed);
  const parts: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);
    parts.push(`${x}vw ${y}vh #fff`);
  }
  return parts.join(', ');
};

const small = shadow(150, 7);
const medium = shadow(60, 31);
const large = shadow(18, 113);
---

<div class="starfield" aria-hidden="true">
  <div class="stars stars-small" style={`box-shadow: ${small}`}></div>
  <div class="stars stars-medium" style={`box-shadow: ${medium}`}></div>
  <div class="stars stars-large" style={`box-shadow: ${large}`}></div>
  <div class="shooting-star shooting-a"></div>
  <div class="shooting-star shooting-b"></div>
</div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  .stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    border-radius: 50%;
    background: transparent;
    will-change: opacity;
  }
  .stars-small {
    animation: twinkle 4.5s ease-in-out infinite;
  }
  .stars-medium {
    width: 1.6px;
    height: 1.6px;
    animation: twinkle 6.5s ease-in-out infinite 0.6s;
  }
  .stars-large {
    width: 2.2px;
    height: 2.2px;
    animation: twinkle-large 9s ease-in-out infinite 1.2s;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.95; }
    50% { opacity: 0.4; }
  }
  @keyframes twinkle-large {
    0%, 100% { opacity: 1; filter: drop-shadow(0 0 1.5px rgba(255, 255, 255, 0.8)); }
    50% { opacity: 0.55; filter: drop-shadow(0 0 0.5px rgba(255, 255, 255, 0.4)); }
  }

  .shooting-star {
    position: absolute;
    width: 180px;
    height: 1.5px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.95) 55%,
      rgba(167, 139, 250, 0.9) 85%,
      transparent
    );
    filter: drop-shadow(0 0 5px rgba(167, 139, 250, 0.7));
    border-radius: 999px;
    opacity: 0;
  }
  .shooting-a {
    top: 12%;
    left: -220px;
    transform: rotate(-18deg);
    animation: shoot 11s linear infinite;
    animation-delay: 2s;
  }
  .shooting-b {
    top: 38%;
    left: -220px;
    transform: rotate(-12deg);
    animation: shoot 14s linear infinite;
    animation-delay: 7s;
  }

  @keyframes shoot {
    0% {
      transform: translate(0, 0) rotate(-18deg);
      opacity: 0;
    }
    3% {
      opacity: 1;
    }
    18% {
      transform: translate(125vw, 38vh) rotate(-18deg);
      opacity: 0;
    }
    100% {
      transform: translate(125vw, 38vh) rotate(-18deg);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stars,
    .shooting-star {
      animation: none;
    }
    .shooting-star { display: none; }
  }

  :global(:root[data-theme='light']) .starfield {
    display: none;
  }
</style>
