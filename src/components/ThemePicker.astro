---
const THEMES = [
  { id: 'space', label: 'Space', vn: 'Không gian' },
  { id: 'galaxy', label: 'Galaxy', vn: 'Giải ngân hà' },
  { id: 'solar', label: 'Solar', vn: 'Hệ mặt trời' },
  { id: 'cyberpunk', label: 'Cyberpunk', vn: 'Cyberpunk' },
];
const MODES = [
  { id: 'dark', label: 'Dark', icon: 'moon' },
  { id: 'light', label: 'Light', icon: 'sun' },
];
---

<div class="theme-picker">
  <button
    class="picker-toggle"
    type="button"
    aria-label="Open theme picker"
    title="Pick a theme"
    aria-expanded="false"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 3a9 9 0 0 1 0 18"></path>
      <path d="M3 12h18"></path>
    </svg>
  </button>

  <div class="picker-panel" role="dialog" aria-label="Theme picker" hidden>
    <div class="panel-head">
      <span class="panel-title">Theme</span>
      <span class="panel-hint">click to apply</span>
    </div>
    <div class="theme-grid">
      {THEMES.map((t) =>
        MODES.map((m) => (
          <button
            class="swatch"
            type="button"
            data-theme={t.id}
            data-mode={m.id}
            aria-label={`${t.label} ${m.label}`}
          >
            <span class={`preview preview-${t.id} preview-${m.id}`} aria-hidden="true"></span>
            <span class="meta">
              <span class="meta-name">{t.label}</span>
              <span class="meta-vn">{t.vn} · {m.label}</span>
            </span>
          </button>
        ))
      )}
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const toggle = document.querySelector('.theme-picker .picker-toggle');
    const panel = document.querySelector('.theme-picker .picker-panel');
    const swatches = document.querySelectorAll('.theme-picker .swatch');
    if (!toggle || !panel) return;

    const close = () => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };
    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      syncActive();
    };

    const syncActive = () => {
      const t = document.documentElement.getAttribute('data-theme') || 'space';
      const m = document.documentElement.getAttribute('data-mode') || 'dark';
      swatches.forEach((s) => {
        const isActive = s.dataset.theme === t && s.dataset.mode === m;
        s.classList.toggle('active', isActive);
      });
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      panel.hidden ? open() : close();
    });

    swatches.forEach((s) => {
      s.addEventListener('click', () => {
        const t = s.dataset.theme;
        const m = s.dataset.mode;
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.setAttribute('data-mode', m);
        try {
          localStorage.setItem('theme', t);
          localStorage.setItem('mode', m);
        } catch (_) {}
        syncActive();
      });
    });

    document.addEventListener('click', (e) => {
      if (panel.hidden) return;
      if (!panel.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
        close();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
  })();
</script>

<style>
  .theme-picker {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 12;
  }

  .picker-toggle {
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-dim);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, transform 150ms ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .picker-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: scale(1.05);
  }
  .picker-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .picker-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    width: 320px;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
  }

  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
    padding: 0 0.2rem;
  }
  .panel-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--fg-dim);
  }
  .panel-hint {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--fg-muted);
  }

  .theme-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.4rem;
  }

  .swatch {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.35rem;
    padding: 0.45rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: inherit;
    cursor: pointer;
    transition: border-color 150ms ease, transform 100ms ease;
    text-align: left;
  }
  .swatch:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .swatch.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 0 12px var(--accent-soft);
  }

  .preview {
    display: block;
    height: 44px;
    border-radius: 5px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    position: relative;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    padding: 0 0.05rem;
  }
  .meta-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--fg);
  }
  .meta-vn {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  /* === Swatch previews (mini-renders of each theme) === */
  .preview-space.preview-dark {
    background:
      radial-gradient(circle 30px at 70% 30%, rgba(167, 139, 250, 0.7), transparent 65%),
      radial-gradient(circle 25px at 25% 75%, rgba(94, 234, 212, 0.6), transparent 65%),
      radial-gradient(1px 1px at 20% 30%, #fff, transparent),
      radial-gradient(1px 1px at 70% 60%, #fff, transparent),
      radial-gradient(1px 1px at 45% 25%, #fff, transparent),
      linear-gradient(135deg, #02030a, #0a0d1d);
  }
  .preview-space.preview-light {
    background:
      radial-gradient(circle 30px at 70% 30%, rgba(167, 139, 250, 0.18), transparent 65%),
      radial-gradient(circle 25px at 25% 75%, rgba(99, 102, 241, 0.12), transparent 65%),
      linear-gradient(135deg, #f5f7ff, #ffffff);
  }
  .preview-galaxy.preview-dark {
    background:
      radial-gradient(circle 38px at 50% 50%, rgba(236, 72, 153, 0.8), transparent 70%),
      radial-gradient(circle 20px at 80% 20%, rgba(192, 38, 211, 0.5), transparent 70%),
      linear-gradient(135deg, #0a0512, #14082a);
  }
  .preview-galaxy.preview-light {
    background:
      radial-gradient(circle 30px at 50% 50%, rgba(192, 38, 211, 0.18), transparent 70%),
      radial-gradient(circle 20px at 80% 20%, rgba(236, 72, 153, 0.12), transparent 70%),
      linear-gradient(135deg, #fdf4ff, #ffffff);
  }
  .preview-solar.preview-dark {
    background:
      radial-gradient(circle 36px at 50% 50%, rgba(251, 191, 36, 0.85), rgba(249, 115, 22, 0.45) 60%, transparent 80%),
      linear-gradient(135deg, #08060a, #1a1208);
  }
  .preview-solar.preview-light {
    background:
      radial-gradient(circle 36px at 50% 50%, rgba(251, 191, 36, 0.3), rgba(249, 115, 22, 0.15) 60%, transparent 80%),
      linear-gradient(135deg, #fffbf0, #ffffff);
  }
  .preview-cyberpunk.preview-dark {
    background:
      linear-gradient(rgba(255, 0, 234, 0.15) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, rgba(0, 240, 255, 0.15) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(135deg, #06020f, #1a0936);
  }
  .preview-cyberpunk.preview-light {
    background:
      linear-gradient(rgba(214, 0, 204, 0.12) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(90deg, rgba(0, 136, 168, 0.12) 1px, transparent 1px) 0 0 / 12px 12px,
      linear-gradient(135deg, #fafafa, #ffffff);
  }

  @media (max-width: 640px) {
    .theme-picker { top: 1rem; right: 1rem; }
    .picker-toggle { width: 34px; height: 34px; }
    .picker-panel {
      width: min(300px, calc(100vw - 2rem));
    }
  }
</style>
