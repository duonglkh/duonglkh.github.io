---
const USERNAME = 'duonglkh';
const PROFILE_URL = `https://github.com/${USERNAME}`;

const STATS_URL = `https://github-readme-stats.vercel.app/api?username=${USERNAME}&show_icons=true&theme=tokyonight&hide_border=true&include_all_commits=true&count_private=true&card_width=400`;
const STREAK_URL = `https://streak-stats.demolab.com/?user=${USERNAME}&theme=tokyonight&hide_border=true`;
const LANGS_URL = `https://github-readme-stats.vercel.app/api/top-langs/?username=${USERNAME}&theme=tokyonight&hide_border=true&layout=compact&hide=html,css&langs_count=8&card_width=400`;
---

<a class="gh-card" href={PROFILE_URL} target="_blank" rel="noopener" aria-label="View GitHub profile">
  <div class="head">
    <div class="head-left">
      <span class="glyph" aria-hidden="true">
        <!-- inline octocat-ish glyph -->
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2.04c-3.2.7-3.88-1.36-3.88-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.76.4-1.27.74-1.56-2.56-.29-5.25-1.28-5.25-5.71 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.19 1.18a11 11 0 0 1 5.81 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.44-2.7 5.41-5.27 5.7.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/>
        </svg>
      </span>
      <div class="profile">
        <span class="name">@{USERNAME}</span>
        <span class="role">github.com/{USERNAME}</span>
      </div>
    </div>
    <span class="cta">View profile <span class="arrow">↗</span></span>
  </div>

  <div class="stats-row">
    <img class="stat-card" src={STATS_URL} alt="GitHub stats" loading="lazy" />
    <img class="stat-card" src={STREAK_URL} alt="Commit streak" loading="lazy" />
  </div>

  <img class="lang-card" src={LANGS_URL} alt="Top languages" loading="lazy" />

  <p class="note">Live widgets — auto-update from GitHub. May briefly fail to load if upstream is slow.</p>
</a>

<style>
  .gh-card {
    display: block;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem 1.1rem;
    color: inherit;
    text-decoration: none;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    margin-bottom: 1.75rem;
  }
  .gh-card:hover {
    border-color: var(--accent-2);
    transform: translateY(-2px);
    color: inherit;
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.18),
      0 8px 30px rgba(94, 234, 212, 0.08);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .head-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--fg);
    flex-shrink: 0;
  }

  .profile {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .name {
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--fg);
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
  }

  .cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-2);
    transition: color 150ms ease, transform 150ms ease;
    white-space: nowrap;
  }
  .gh-card:hover .cta {
    color: var(--accent);
  }
  .arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }
  .gh-card:hover .arrow {
    transform: translate(2px, -2px);
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .stat-card,
  .lang-card {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    background: rgba(2, 3, 10, 0.4);
  }

  .lang-card {
    margin-bottom: 0.85rem;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--fg-muted);
    text-align: center;
    margin: 0;
    opacity: 0.7;
  }

  @media (max-width: 640px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .cta {
      align-self: flex-end;
    }
  }

  /* Light mode: invert filter-less, just adjust */
  :global(:root[data-mode='light']) .stat-card,
  :global(:root[data-mode='light']) .lang-card {
    background: rgba(255, 255, 255, 0.4);
  }
</style>
